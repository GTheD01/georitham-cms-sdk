{
  "name": "georitham-cms-sdk",
  "version": "0.1.0",
  "description": "Client, types and tooling for Georitham CMS — a headless CMS with structured sections.",
  "keywords": [
    "cms",
    "headless",
    "headless-cms",
    "georitham",
    "content",
    "sdk",
    "astro",
    "nextjs",
    "cloudflare-workers",
    "typescript"
  ],
  "license": "MIT",
  "author": "Georitham",
  "homepage": "https://cms.georitham.ch",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GTheD01/georitham-cms-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/GTheD01/georitham-cms-sdk/issues"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./webhooks": {
      "types": "./dist/webhooks.d.ts",
      "default": "./dist/webhooks.js"
    },
    "./snapshot": {
      "types": "./dist/snapshot.d.ts",
      "default": "./dist/snapshot.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "georitham-cms": "./dist/cli/index.js"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "tsc",
    "test": "npm run build && node --test test/*.test.mjs",
    "prepare": "npm run build",
    "prepublishOnly": "npm test"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.3"
  }
}
